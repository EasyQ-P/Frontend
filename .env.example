# .env.local로 복사해서 값을 채우세요. 실제 값은 이 파일에 쓰지 마세요.
# cp .env.example .env.local

# 시연용 요소(데모 버튼 · 예시 코드 등) 표시 여부. 시연할 때만 true
NEXT_PUBLIC_DEMO=false

# ── 로컬 개발 전용 ──
# 브라우저는 항상 같은 출처의 /api/v1만 호출한다. 운영에서는 Caddy가 나눠 주므로 비워 둔다.
# 로컬에서는 Next.js 개발 서버가 아래 주소로 대신 넘겨 준다. 값을 바꾸면 개발 서버를 다시 켜야 한다.
# backend 주소
# API_PROXY_TARGET=http://localhost:8000
# auth 주소 (비우면 API_PROXY_TARGET으로 보냄)
# AUTH_PROXY_TARGET=http://localhost:8001
